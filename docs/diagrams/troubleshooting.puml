@startuml
!include _style.iuml
start
if (Status says **Connected**?) then (no)
  if (Adapter listed under\nSettings → Connectivity → Serial?) then (no)
    :Use an **RS232** adapter (not TTL)\nand another USB port;
    stop
  else (yes)
    :Check the amplifier is on,\nthe cable, and the model chosen;
    stop
  endif
else (yes)
  if (Zones follow what you do?) then (no)
    :Check the model chosen —\nor another program uses the adapter;
    stop
  else (yes)
    :✅ All good;
    stop
  endif
endif
@enduml
