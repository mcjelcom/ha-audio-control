@startuml
!include _style.iuml
start
if (Connection says **Connected**?) then (no)
  if (Adapter listed in\nSettings → Connectivity → Serial?) then (no)
    :Use a **USB-RS232** adapter (not TTL),\ntry another USB port, use the official PSU;
    stop
  else (yes)
    :Check amplifier power and cable,\ntry the other cable type (null-modem),\ncheck the right model is selected;
    stop
  endif
else (yes)
  if (Zones follow changes?) then (no)
    :Wrong model selected, or another\nprogram is using the adapter;
    stop
  else (yes)
    :All good 🎉;
    stop
  endif
endif
@enduml
