@startuml
!include _style.iuml
left to right direction
rectangle "Device profile\n(YAML)" as p
rectangle "**Text** engine\nASCII + patterns" as text
rectangle "**Binary** engine\nframes + checksums" as bin
rectangle "**JSON** engine\nlogin + templates" as json
rectangle "Serial / network\nconnection" as conn
p --> text
p --> bin
p --> json
text --> conn
bin --> conn
json --> conn
@enduml
